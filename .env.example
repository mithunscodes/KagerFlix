# KagerFlix Environment Configuration
# Copy this file to .env and fill in your values

# Flask Secret Key (IMPORTANT: Change this in production!)
# Generate a new secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-prod

# AWS S3 Configuration (Optional - leave blank to use local storage)
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Database URI (SQLite by default, change for production)
# SQLALCHEMY_DATABASE_URI=sqlite:///videos.db

# Flask Environment
FLASK_ENV=production

# Debug Mode (Set to False in production)
FLASK_DEBUG=False
